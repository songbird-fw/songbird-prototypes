{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.songbird-fw.com/v1alpha1/staticroute.schema.json",
  "title": "StaticRoute",
  "description": "PoC PROPOSAL, not part of songbird-yaml-schema v1alpha1 (listed there as 'Not covered yet'). Follows domain-model.md v0.6 StaticRoute (DM-22, DM-23, R-001.5). Among routes to the same destination the active one has the lowest distance, then the lowest priority; ties are rejected by the validator.",
  "x-songbird-status": "proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "StaticRoute" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "gateway", "interface"],
      "properties": {
        "destination": { "$ref": "common.schema.json#/$defs/ipv4Cidr" },
        "gateway": { "description": "Must lie in a subnet of 'interface' (DM-22).", "$ref": "common.schema.json#/$defs/ipv4Address" },
        "interface": { "description": "Outgoing Interface (domain model: outInterface).", "$ref": "common.schema.json#/$defs/reference" },
        "distance": { "type": "integer", "minimum": 1, "maximum": 255, "default": 10 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 1 }
      }
    }
  }
}
